# Copy to apps/api/.env  (Prisma CLI and the API both load this file).
# NEVER commit real secrets. Generate fresh values for anything beyond local dev.

NODE_ENV=development
PORT=3001
LOG_LEVEL=log
LOG_JSON=false
CORS_ORIGINS=
DATABASE_URL=postgresql://pegpal:pegpal_dev_only@localhost:5433/pegpal?schema=public

# --- Hardware -------------------------------------------------------------
# mock  : in-process simulator (default, no hardware needed)
# esp32 : real controller over MQTT/TLS; ALSO requires ENABLE_ESP32_ADAPTER=true
HARDWARE_MODE=mock
ENABLE_ESP32_ADAPTER=false
SCALE_FITTED=false
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CA_FILE=
HEARTBEAT_TIMEOUT_MS=30000

# --- Payment (no real provider is integrated) -----------------------------
# TEST_MODE        : simulated payment confirmation; no money moves
# PAYMENT_DISABLED : no payment step; controlled internal testing only
PAYMENT_MODE=TEST_MODE
# Must be true to start with NODE_ENV=production in either mode above.
ALLOW_UNPAID_DISPENSING=false

# --- Secrets --------------------------------------------------------------
ADMIN_USERNAME=operator
# Generate: bun run --cwd apps/api hash-password '<your password>'
# Keep the single quotes: docker compose would otherwise expand the '$' characters.
# The value below is for the dev password "pegpal-dev-password" ONLY.
ADMIN_PASSWORD_HASH='scrypt$z6VkDu4gll6PxY988zM+eA==$TIg4JMtTodgctcOb4viFIeOOv6bFhRmivUUIMtuJuQIthC+zkXArO2IS6ZgArs42JkaODmuRUVAcUAEnRBnQfg=='
# openssl rand -base64 48
ADMIN_JWT_SECRET=change-me-dev-only-jwt-secret-0123456789abcdef
ADMIN_JWT_TTL_SEC=3600
# openssl rand -base64 48
ORDER_TOKEN_SECRET=change-me-dev-only-order-token-secret-0123456789
# openssl rand -base64 32   (exactly 32 bytes)
MACHINE_SECRET_ENCRYPTION_KEY=__GENERATE__

# --- Safety limits (server side; firmware enforces its own) ----------------
ORDER_MAX_TOTAL_ML=400
ORDER_MAX_ITEMS=10
ORDER_CONFIRM_TTL_SEC=300
ORDER_MAX_DURATION_MS=300000
PUMP_MAX_RUNTIME_MS=60000
RUNTIME_SAFETY_FACTOR=1.5
RUNTIME_ALLOWANCE_MS=1500
ACK_TIMEOUT_MS=1500
ACK_RETRIES=3
COMPLETION_GRACE_MS=3000
STOP_CONFIRM_TIMEOUT_MS=5000
TARE_TIMEOUT_MS=8000
CALIBRATION_MAX_RUNTIME_MS=30000
MASS_PLAUSIBILITY_PCT=35
RATE_LIMIT_PER_MIN=120

# --- Mock simulator --------------------------------------------------------
MOCK_TIME_SCALE=1
MOCK_TICK_MS=100
MOCK_FW_MAX_RUNTIME_MS=60000
