generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MachineServiceStatus {
  IN_SERVICE
  OUT_OF_SERVICE
  /// Locked after an uncertain outcome or safety event until an operator clears it.
  NEEDS_ATTENTION
}

enum HardwareConnection {
  CONNECTED
  DISCONNECTED
  UNKNOWN
}

enum OrderStatus {
  CREATED
  AUTHORIZED
  QUEUED
  DISPENSING
  COMPLETED
  FAILED
  CANCELLED
  SAFETY_STOPPED
}

enum OrderItemStatus {
  PENDING
  DISPENSING
  COMPLETED
  FAILED
  STOPPED
  SKIPPED
  UNKNOWN
}

enum VerificationLevel {
  MASS_DELTA
  ESTIMATED
  SIMULATED
  UNVERIFIED
}

enum DispenseStrategy {
  TIMED
  WEIGHT
}

enum PaymentMode {
  TEST_MODE
  PAYMENT_DISABLED
}

enum PaymentStatus {
  PENDING
  TEST_CONFIRMED
  NOT_REQUIRED
}

enum EventSeverity {
  INFO
  WARN
  SAFETY
}

enum CalibrationKind {
  FLOW_RATE
  VALIDATION
}

enum CalibrationStatus {
  RUNNING
  AWAITING_MEASUREMENT
  COMPLETED
  FAILED
}

enum CommandType {
  DISPENSE
  STOP
  TARE
  STATUS_REQUEST
}

enum CommandOutcome {
  PENDING
  ACKED
  REJECTED
  DONE
  FAILED
  STOPPED
  UNKNOWN
}

model Machine {
  id                     String               @id @default(uuid()) @db.Uuid
  publicId               String               @unique
  name                   String
  status                 MachineServiceStatus @default(IN_SERVICE)
  hardwareConnection     HardwareConnection   @default(UNKNOWN)
  estopActive            Boolean              @default(false)
  faultReason            String?
  /// ISO 4217 code used for all prices on this machine.
  currency               String               @default("INR")
  /// Reservation: at most one active order or calibration run.
  activeOrderId          String?              @unique @db.Uuid
  activeCalibrationRunId String?              @unique @db.Uuid
  /// Monotonic command sequence for the controller protocol.
  commandSeq             Int                  @default(0)
  lastSeenAt             DateTime?
  lastStatus             Json?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  liquids         Liquid[]
  orders          Order[]
  events          DispensingEvent[]
  commands        HardwareCommand[]
  credentials     MachineCredential[]
  calibrationRuns CalibrationRun[]
}

model Liquid {
  id                   String           @id @default(uuid()) @db.Uuid
  machineId            String           @db.Uuid
  name                 String
  imageUrl             String?
  /// Logical pump channel 0..9 (never a GPIO number).
  pumpChannel          Int
  strategy             DispenseStrategy @default(TIMED)
  /// g/mL; null until measured.
  densityGPerMl        Float?
  /// Calibration profile: null means not yet calibrated (not dispensable).
  flowRateMlPerSec     Float?
  /// WEIGHT strategy: stop this many grams early to absorb run-on.
  cutoffMarginG        Float            @default(1)
  calibratedAt         DateTime?
  calibrationSimulated Boolean          @default(false)
  minMl                Int
  maxMl                Int
  pricePerMl           Decimal          @db.Decimal(12, 4)
  active               Boolean          @default(true)
  remainingStockMl     Int?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  machine         Machine          @relation(fields: [machineId], references: [id])
  orderItems      OrderItem[]
  calibrationRuns CalibrationRun[]

  @@unique([machineId, pumpChannel])
  @@index([machineId])
}

model Order {
  id                  String        @id @default(uuid()) @db.Uuid
  machineId           String        @db.Uuid
  status              OrderStatus   @default(CREATED)
  totalVolumeMl       Int
  totalPrice          Decimal       @db.Decimal(12, 2)
  currency            String
  idempotencyKey      String        @unique
  /// SHA-256 of the normalized create request, to detect key reuse with a different body.
  requestHash         String
  paymentMode         PaymentMode
  paymentStatus       PaymentStatus @default(PENDING)
  /// Never card data. A simulated reference in TEST_MODE.
  paymentReference    String?
  cancelRequestedAt   DateTime?
  failureReason       String?
  expiresAt           DateTime?
  authorizedAt        DateTime?
  dispensingStartedAt DateTime?
  finishedAt          DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  machine  Machine           @relation(fields: [machineId], references: [id])
  items    OrderItem[]
  events   DispensingEvent[]
  commands HardwareCommand[]

  @@index([machineId, createdAt])
  @@index([status])
}

model OrderItem {
  id               String             @id @default(uuid()) @db.Uuid
  orderId          String             @db.Uuid
  liquidId         String             @db.Uuid
  position         Int
  /// Snapshot of configuration at order time.
  liquidName       String
  pumpChannel      Int
  unitPrice        Decimal            @db.Decimal(12, 4)
  linePrice        Decimal            @db.Decimal(12, 2)
  requestedMl      Int
  targetMassG      Float?
  measuredMassG    Float?
  deliveredMl      Float?
  verification     VerificationLevel?
  verificationNote String?
  status           OrderItemStatus    @default(PENDING)
  runtimeMs        Int?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  liquid Liquid @relation(fields: [liquidId], references: [id])

  @@unique([orderId, position])
  @@unique([orderId, liquidId])
}

/// Append-only audit log for dispensing, safety and admin actions.
model DispensingEvent {
  id               String        @id @default(uuid()) @db.Uuid
  machineId        String?       @db.Uuid
  orderId          String?       @db.Uuid
  calibrationRunId String?       @db.Uuid
  type             String
  severity         EventSeverity @default(INFO)
  pumpChannel      Int?
  liquidId         String?       @db.Uuid
  payload          Json?
  actor            String?
  createdAt        DateTime      @default(now())

  machine Machine? @relation(fields: [machineId], references: [id])
  order   Order?   @relation(fields: [orderId], references: [id])

  @@index([machineId, createdAt])
  @@index([orderId, createdAt])
  @@index([severity, createdAt])
}

/// Every command sent to a controller, persisted before it is sent.
model HardwareCommand {
  id               String         @id @db.Uuid
  machineId        String         @db.Uuid
  orderId          String?        @db.Uuid
  orderItemId      String?        @db.Uuid
  calibrationRunId String?        @db.Uuid
  type             CommandType
  seq              Int
  payload          Json
  outcome          CommandOutcome @default(PENDING)
  attempts         Int            @default(0)
  ackedAt          DateTime?
  finishedAt       DateTime?
  result           Json?
  createdAt        DateTime       @default(now())

  machine Machine @relation(fields: [machineId], references: [id])
  order   Order?  @relation(fields: [orderId], references: [id])

  @@unique([machineId, seq])
  @@index([orderId])
}

/// Revocable HMAC keys used to sign controller messages.
model MachineCredential {
  id              String    @id @default(uuid()) @db.Uuid
  machineId       String    @db.Uuid
  keyId           String    @unique
  /// AES-256-GCM encrypted secret (iv:tag:ciphertext, base64).
  secretEncrypted String
  lastDeviceSeq   Int       @default(0)
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  machine Machine @relation(fields: [machineId], references: [id])

  @@index([machineId])
}

model CalibrationRun {
  id                 String            @id @default(uuid()) @db.Uuid
  machineId          String            @db.Uuid
  liquidId           String            @db.Uuid
  pumpChannel        Int
  kind               CalibrationKind
  status             CalibrationStatus @default(RUNNING)
  commandedRuntimeMs Int?
  actualRuntimeMs    Int?
  targetMl           Float?
  measuredMl         Float?
  measuredMassG      Float?
  computedDensity    Float?
  computedFlowRate   Float?
  previousFlowRate   Float?
  errorPct           Float?
  simulated          Boolean
  simulatedReadingMl Float?
  applied            Boolean           @default(false)
  operator           String
  failureReason      String?
  createdAt          DateTime          @default(now())
  completedAt        DateTime?

  machine Machine @relation(fields: [machineId], references: [id])
  liquid  Liquid  @relation(fields: [liquidId], references: [id])

  @@index([liquidId, createdAt])
}
